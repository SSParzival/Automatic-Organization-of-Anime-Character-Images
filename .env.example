# Pipeline directory defaults, auto-loaded by scripts/run_pipeline.py (CLI flags override them).
ANIME_PIPELINE_INPUT_DIR=/absolute/path/to/input_images
ANIME_PIPELINE_PROJECT_DIR=/absolute/path/to/anime_character_pipeline
# Optional HuggingFace model cache (defaults to ~/.cache/huggingface).
# HF_HOME=/absolute/path/to/model_cache
# Optional reverse image search for characters the local tagger cannot name (free accounts).
# Danbooru IQDB: username and API key from your Danbooru profile.
# DANBOORU_LOGIN=your_username
# DANBOORU_API_KEY=your_api_key
# SauceNAO: API key from https://saucenao.com/user.php?page=search-api
# SAUCENAO_API_KEY=your_api_key
